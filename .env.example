# Copy to .env. Replace placeholders with newly generated secrets before use.
# Generate each secret: python -c 'import secrets; print(secrets.token_urlsafe(48))'
INVITEFLOW_ENVIRONMENT=development
INVITEFLOW_DATABASE_URL=postgresql+asyncpg://inviteflow:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1:5432/inviteflow
INVITEFLOW_SESSION_SECRET=
# Browser origin must match exactly. Local Vite dev server uses 5173.
INVITEFLOW_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Local HTTP only; production requires true and HTTPS.
INVITEFLOW_COOKIE_SECURE=false
INVITEFLOW_BUSINESS_HOOKS_ENABLED=false
# Compose uses a private postgres hostname; use a URL-safe random password.
INVITEFLOW_POSTGRES_PASSWORD=
INVITEFLOW_WEB_PORT=8088
# Manual maintenance; sessions wait one day after expiry/revocation, sent outbox seven days.
INVITEFLOW_SESSION_CLEANUP_RETENTION_SECONDS=86400
INVITEFLOW_OUTBOX_CLEANUP_RETENTION_SECONDS=604800
